seg001:2B5F INT10_AH4B      proc near
seg001:2B5F                 xor     ax, ax          ; AH=4Bh — Display-list runner (keyboard-aware)
seg001:2B5F                                         ;
seg001:2B5F                                         ; First, deliver latched extended scan: xchg al,[1AC3]; if AL≠0 → return.
seg001:2B5F                                         ;
seg001:2B5F                                         ; If pending list ([1AB5] != 0), continue it via sub_F2B9B.
seg001:2B5F                                         ;
seg001:2B5F                                         ; Else block for key (int 16h, AH=00), then filter (sub_F2B3B).
seg001:2B5F                                         ;
seg001:2B5F                                         ; If filter says “process,” it consumes 2 or 3 bytes from ES:BX (adjusts BX/CX; stores [1AB6]/[1AB5]), calls sub_F2B9B to perform the action, loops.
seg001:2B5F                                         ;
seg001:2B5F                                         ; If key should be returned:
seg001:2B5F                                         ;
seg001:2B5F                                         ; AL≠0 → return ASCII now.
seg001:2B5F                                         ;
seg001:2B5F                                         ; AL==0 (extended) → store AH → [1AC3] and return (two-step delivery).
seg001:2B5F                                         ; Use: stateful UI/script executor that interleaves drawing with keyboard input.
seg001:2B61                 xchg    al, byte ptr unk_1AC3
seg001:2B65                 or      al, al
seg001:2B67                 jnz     short locret_F2B9A
seg001:2B69

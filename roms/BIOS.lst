seg001:2BB5 INT40_AH4C      proc near               ; CODE XREF: INT40_AH4C+25↓j
seg001:2BB5                 mov     al, byte ptr unk_1AC3 ; AH=4Ch — Non-blocking poll/feeder
seg001:2BB5                                         ;
seg001:2BB5                                         ; If [1AC3] latched → AL=[1AC3], return ready.
seg001:2BB5                                         ;
seg001:2BB5                                         ; Else if pending list → AL = ES:[BX] (from [1AB6]), return ready.
seg001:2BB5                                         ;
seg001:2BB5                                         ; Else check keyboard (int 16h, AH=01):

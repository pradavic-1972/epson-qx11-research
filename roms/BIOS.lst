seg001:20CC INT10_AH0A      proc near
seg001:20CC                 mov     ah, ch          ; ; INT10 AH=0Ah — Write Char Only at Cursor (repeat CX)
seg001:20CC                                         ; ; In:  AL=char, BH=page (0..1), CX=count; (BL ignored in text modes)
seg001:20CC                                         ; ; Text: preserves attribute by reading it each time (sub_F1BDB → AH → [08B3]),
seg001:20CC                                         ; ;       writes char via tri-plane writer, advances cursor, repeats CX times.
seg001:20CC                                         ; ; Graphics: jumps to AH=09h implementation.
seg001:20CC                                         ; ; Uses: [086C]=count, [08B2]=char, [08B3]=attr(to preserve), page swap via sub_F19B1,
seg001:20CC                                         ; ;       helpers sub_F1BD3/F1D1C/F1892/F1C03/F1F1C/F1FF1, pre/post sub_F2773/F2767.
seg001:20CE                 or      ah, cl
seg001:20D0                 jz      short locret_F2142

seg001:2B69                 cmp     byte ptr unk_1AB5, 0
seg001:2B6E                 jnz     short sub_F2B9B
seg001:2B70                 mov     ah, 0
seg001:2B72                 int     16h             ; KEYBOARD - READ CHAR FROM BUFFER, WAIT IF EMPTY
seg001:2B72                                         ; Return: AH = scan code, AL = character
seg001:2B74                 call    sub_F2B3B
seg001:2B77                 jnz     short loc_F2B8E
seg001:2B79                 dec     cx
seg001:2B7A                 dec     cx
seg001:2B7B                 inc     bx
seg001:2B7C                 inc     bx
seg001:2B7D                 or      al, al
seg001:2B7F                 jnz     short loc_F2B83
seg001:2B81                 dec     cx
seg001:2B82                 inc     bx
